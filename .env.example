# Copy to .env and fill in. Everything here is optional: without Firebase values the app
# runs in dry-run mode, which shows reminder previews on screen instead of sending them.

# --- Server (Firebase Admin SDK) ---
# Path to a service account JSON key (Firebase console > Project settings > Service accounts).
FIREBASE_CREDENTIALS=

# --- Browser (Firebase console > Project settings > General > Your apps > Web app) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Project settings > Cloud Messaging > Web Push certificates > Key pair
FIREBASE_VAPID_KEY=

# Public https URL of the app. Tapping a notification opens it. Leave blank on localhost.
UNIFIT_APP_URL=

# Optional overrides
# UNIFIT_DB=data/unifit.db
# UNIFIT_MODEL=data/model.joblib
# HOST=127.0.0.1
# PORT=5000
